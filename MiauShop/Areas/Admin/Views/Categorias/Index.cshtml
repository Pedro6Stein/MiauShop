@model List<CategoriaLinha>
@{
    ViewData["Title"] = "Categorias";
    var podeAlterar = ViewData["PodeAlterar"] is true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Categorias</h1>
    @if (podeAlterar)
    {
        <a class="ms-botao ms-botao-pequeno" asp-action="Nova"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nova categoria</a>
    }
</div>

<section class="ms-form-bloco">
    <div class="table-responsive">
        <table class="table align-middle mb-0 ms-tabela ms-tabela-cartoes">
            <thead><tr><th>Ordem</th><th>Categoria</th><th>Endereço na loja</th><th class="text-center">Produtos</th><th>Situação</th><th></th></tr></thead>
            <tbody>
                @foreach (var linha in Model)
                {
                    var categoria = linha.Categoria;
                    <tr>
                        <td data-label="Ordem">@categoria.Ordem</td>
                        <td class="fw-bold"><i class="bi @categoria.Icone text-danger me-2" aria-hidden="true"></i>@categoria.Nome</td>
                        <td data-label="Endereço"><code>/Produtos?categoria=@categoria.Slug</code></td>
                        <td data-label="Produtos" class="text-center">@linha.QuantidadeProdutos</td>
                        <td data-label="Situação"><span class="ms-status @(categoria.Ativa ? "ms-status-Entregue" : "ms-status-Cancelado")">@(categoria.Ativa ? "Ativa" : "Inativa")</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@categoria.Id">@(podeAlterar ? "Editar" : "Ver")</a>
                            @if (podeAlterar && linha.QuantidadeProdutos == 0)
                            {
                                <form class="d-inline" method="post" asp-action="Excluir" asp-route-id="@categoria.Id">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="ms-dica mb-0 mt-2">Categorias com produtos não podem ser excluídas; desative para tirá-las da loja.</p>
</section>
