@model LoginAdmin
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Painel administrativo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="ms-form-bloco text-center">
            <div class="ms-modal-icone"><i class="bi bi-speedometer2" aria-hidden="true"></i></div>
            <h1 class="h3">Painel administrativo</h1>
            <p class="text-body-secondary">Pedidos, produtos, categorias e fornecedores da MiauShop.</p>

            @if (ViewData["Bloqueado"] is true)
            {
                <div class="alert alert-warning text-start" role="alert">Muitas tentativas seguidas. Aguarde um minuto.</div>
            }

            @* Acesso de demonstração do portfólio (papel Visualizador). Some quando DemoHabilitada = false. *@
            @if (ViewData["DemoHabilitada"] is true)
            {
                <form method="post" asp-action="EntrarComoVisitante">
                    <button class="ms-botao ms-botao-grande w-100 justify-content-center" type="submit">
                        <i class="bi bi-eye" aria-hidden="true"></i>Entrar como visitante
                    </button>
                </form>
                <p class="ms-dica mt-2">Sem senha. Você vê o painel inteiro, mas nada é alterado.</p>

                <div class="ms-separador"><span>ou, se você administra a loja</span></div>
            }

            <form method="post" asp-action="Entrar" class="ms-form text-start" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-warning"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="username" />
                    <span asp-validation-for="Email" class="ms-erro"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Senha" class="form-label"></label>
                    <input asp-for="Senha" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Senha" class="ms-erro"></span>
                </div>
                <button class="ms-botao ms-botao-claro w-100 justify-content-center" type="submit">
                    <i class="bi bi-lock" aria-hidden="true"></i>Entrar com e-mail e senha
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
