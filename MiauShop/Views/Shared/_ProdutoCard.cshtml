@model MiauShop.Models.Entities.Produto
@{
    var url = $"/Produtos/{Model.Slug}";
}
<article class="ms-card">
    <a class="ms-card-imagem" href="@url" tabindex="-1" aria-hidden="true">
        <img src="@Model.ImagemPrincipalUrl()" alt="" loading="lazy" width="900" height="900" />
        @if (Model.EmPromocao())
        {
            <span class="ms-selo">-@Model.PercentualDesconto()%</span>
        }
    </a>
    <div class="ms-card-corpo">
        <span class="ms-card-categoria">@Model.Categoria.Nome</span>
        <a class="ms-card-nome" href="@url">@Model.Nome</a>
        <div class="ms-card-rodape">
            <div class="ms-card-precos">
                @if (Model.EmPromocao())
                {
                    <div class="ms-preco-antigo">@Model.Preco.ToString("C")</div>
                    <div class="ms-preco ms-preco-promo">@Model.PrecoAtual().ToString("C")</div>
                }
                else
                {
                    <div class="ms-preco">@Model.PrecoAtual().ToString("C")</div>
                }
            </div>
            @* "+": sem tamanho, adiciona direto ao carrinho; com tamanho, abre a janelinha de escolha
               (sem JavaScript, o link leva para a página do produto). *@
            @if (Model.Variacoes.Count == 1)
            {
                <form method="post" action="/Carrinho/Adicionar" data-form-carrinho>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="variacaoId" value="@Model.Variacoes.First().Id" />
                    <button class="ms-botao-mais" type="submit" aria-label="Adicionar @Model.Nome ao carrinho">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    </button>
                </form>
            }
            else
            {
                <a class="ms-botao-mais" href="@url" role="button" data-escolher-url="@url/escolher"
                   aria-label="Escolher tamanho de @Model.Nome">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                </a>
            }
        </div>
    </div>
</article>
