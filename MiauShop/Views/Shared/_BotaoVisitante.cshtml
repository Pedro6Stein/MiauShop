@model BotaoVisitante
@inject Microsoft.Extensions.Options.IOptions<MiauShop.Services.Seguranca.OpcoesAdministrador> OpcoesAdmin
@if (OpcoesAdmin.Value.DemoHabilitada)
{
    @* Um clique e a pessoa já está no painel (papel Visualizador: vê tudo, não altera nada). *@
    <form class="ms-form-visitante" method="post" asp-area="Admin" asp-controller="Conta" asp-action="EntrarComoVisitante">
        <button class="@Model.Classe" type="submit" title="Entrar no painel como visitante: sem senha, somente leitura">
            <i class="bi @Model.Icone" aria-hidden="true"></i><span>@Model.Texto</span>@if (Model.Complemento is not null)
            {<span class="visually-hidden"> @Model.Complemento</span>}
        </button>
    </form>
}
else
{
    <a class="@Model.Classe" href="/Admin"><i class="bi @Model.Icone" aria-hidden="true"></i><span>@Model.Texto</span></a>
}
