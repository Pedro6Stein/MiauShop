@inject MiauShop.Services.Interfaces.ICarrinhoService CarrinhoService
@{
    var itensNoCarrinho = CarrinhoService.ContarItens();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | MiauShop</title>
    <meta name="description" content="MiauShop: brinquedos, comidinhas, roupinhas e acessórios para cães e gatos. Projeto demonstrativo." />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/miaushop.css" asp-append-version="true" />
</head>
<body>
    <div class="ms-faixa-demo">
        <span><i class="bi bi-info-circle" aria-hidden="true"></i> Projeto demonstrativo: nenhuma compra ou pagamento é real.</span>
        <partial name="_BotaoVisitante" model='new BotaoVisitante("Conheça o painel administrativo (sem senha)", "ms-faixa-demo-link", "bi-arrow-right-circle")' />
    </div>

    <header class="ms-header">
        <div class="container d-flex flex-wrap align-items-center gap-2 gap-md-3 py-3">
            <a class="ms-logo" href="/" aria-label="MiauShop, página inicial">
                <i class="bi bi-heart-fill" aria-hidden="true"></i><b class="fw-semibold">Miau<span>Shop</span></b>
            </a>

            <form class="ms-busca order-last order-md-0" action="/Produtos" method="get" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="busca" placeholder="Buscar mimos para seu pet" aria-label="Buscar produtos" />
            </form>

            <nav class="d-flex align-items-center gap-1 ms-auto" aria-label="Navegação principal">
                <a class="ms-nav-link" href="/Produtos?animal=Cao">Cães</a>
                <a class="ms-nav-link" href="/Produtos?animal=Gato">Gatos</a>
                <a class="ms-nav-link d-none d-sm-inline" href="/Pedido/Acompanhar">Meu pedido</a>
                <partial name="_BotaoVisitante" model='new BotaoVisitante("Painel", "ms-nav-painel", Complemento: "administrativo, entrar como visitante sem senha")' />
            </nav>

            <a class="ms-carrinho ms-2" href="/Carrinho" aria-label="Carrinho, @itensNoCarrinho itens">
                <i class="bi bi-bag-heart" aria-hidden="true"></i>
                <span class="ms-carrinho-contador" data-carrinho-contador hidden="@(itensNoCarrinho == 0)">@itensNoCarrinho</span>
            </a>
        </div>
    </header>

    <main class="container py-4">
        @if (TempData["Erro"] is string erro)
        {
            <div class="alert alert-warning" role="alert">@erro</div>
        }
        @RenderBody()
    </main>

    @* Janelinha de tamanho do "+" dos cards: o conteúdo vem pronto do servidor. *@
    <div class="modal fade" id="ms-modal-escolha" tabindex="-1" aria-labelledby="titulo-escolha" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content ms-modal" data-modal-conteudo></div>
        </div>
    </div>

    @* Assistente "Ajuda": menu numerado + respostas cadastradas no painel. As respostas vêm prontas do servidor. *@
    <div class="ms-assistente" data-assistente>
        <section class="ms-assistente-painel" id="ms-assistente-painel" role="dialog" aria-labelledby="ms-assistente-titulo" hidden data-assistente-painel>
            <header class="ms-assistente-topo">
                <span class="ms-assistente-avatar" aria-hidden="true"><i class="bi bi-heart-fill"></i></span>
                <span class="flex-grow-1">
                    <strong id="ms-assistente-titulo">Miau, assistente da loja</strong>
                    <small>Respostas automáticas</small>
                </span>
                <button class="btn-close btn-close-white" type="button" aria-label="Fechar o assistente" data-assistente-fechar></button>
            </header>
            <div class="ms-assistente-mensagens" aria-live="polite" data-assistente-mensagens></div>
            <form class="ms-assistente-form" method="post" action="/Assistente/Mensagem" data-assistente-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="etapa" value="inicio" />
                <input type="hidden" name="contexto" value="" />
                <label class="visually-hidden" for="ms-assistente-texto">Mensagem para o assistente</label>
                <input id="ms-assistente-texto" name="texto" autocomplete="off" maxlength="200" placeholder="Digite o número da opção ou sua dúvida" />
                <button type="submit" aria-label="Enviar mensagem"><i class="bi bi-send-fill" aria-hidden="true"></i></button>
            </form>
        </section>
        <button class="ms-assistente-botao" type="button" aria-expanded="false" aria-controls="ms-assistente-painel" data-assistente-abrir>
            <i class="bi bi-chat-heart-fill" aria-hidden="true"></i><span>Ajuda</span>
        </button>
    </div>

    @* Aviso rápido usado pelo "Adicionar ao carrinho". *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="ms-aviso" class="toast ms-aviso" role="status" aria-live="polite" aria-atomic="true">
            <div class="d-flex align-items-center gap-3 p-3">
                <i class="bi bi-bag-check-fill" aria-hidden="true"></i>
                <span class="flex-grow-1 fw-bold" data-aviso-texto></span>
                <a class="ms-aviso-link" href="/Carrinho" data-aviso-link>Ver carrinho</a>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Fechar aviso"></button>
            </div>
        </div>
    </div>

    <footer class="ms-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="ms-logo mb-2"><i class="bi bi-heart-fill" aria-hidden="true"></i><b class="fw-semibold">Miau<span>Shop</span></b></div>
                    <p class="mb-0">Mimos selecionados para cães e gatos, enviados direto pelos nossos fornecedores parceiros.</p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="h6">Loja</h3>
                    <ul class="list-unstyled d-grid gap-1 mb-0">
                        <li><a href="/Produtos?animal=Cao">Para cães</a></li>
                        <li><a href="/Produtos?animal=Gato">Para gatos</a></li>
                        <li><a href="/Pedido/Acompanhar">Acompanhar pedido</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <h3 class="h6">Sobre o projeto</h3>
                    <p class="mb-2">Loja fictícia criada para fins acadêmicos e de portfólio. Produtos, preços e pedidos são apenas demonstrativos.</p>
                    <partial name="_BotaoVisitante" model='new BotaoVisitante("Ver o painel administrativo (visitante, sem senha)", "ms-link-rodape")' />
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <small>&copy; @DateTime.Now.Year MiauShop · Projeto demonstrativo</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="~/js/miaushop.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
