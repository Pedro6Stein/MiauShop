@model MiauShop.Models.Carrinho
@* Resumo do pedido montado pelo servidor a partir do carrinho. *@
<aside class="ms-resumo" aria-labelledby="titulo-resumo-checkout">
    <h2 class="h5" id="titulo-resumo-checkout">Resumo do pedido</h2>
    <ul class="ms-resumo-itens">
        @foreach (var linha in Model.Linhas)
        {
            var produto = linha.Variacao.Produto;
            <li>
                <span class="ms-resumo-foto">
                    <img src="@produto.ImagemPrincipalUrl()" alt="" width="56" height="56" />
                    <span class="ms-resumo-qtd">@linha.Quantidade</span>
                </span>
                <span class="flex-grow-1">
                    <span class="d-block fw-bold">@produto.Nome</span>
                    @if (!linha.Variacao.EhUnica())
                    {
                        <small class="text-body-secondary">Tamanho: @linha.Variacao.Nome</small>
                    }
                </span>
                <span class="fw-bold">@linha.Subtotal.ToString("C")</span>
            </li>
        }
    </ul>
    <dl>
        <div><dt>Subtotal</dt><dd>@Model.Subtotal.ToString("C")</dd></div>
        <partial name="_LinhaFrete" model="Model" />
        <div class="ms-resumo-total"><dt>Total@(Model.FreteDefinido ? "" : " (sem frete)")</dt><dd>@Model.Total.ToString("C")</dd></div>
    </dl>
    <partial name="_DetalheFrete" model="Model" />
    <a class="d-block text-center small fw-bold" href="/Carrinho">Alterar carrinho</a>
</aside>
